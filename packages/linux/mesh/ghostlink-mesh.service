[Unit]
Description=Ghostlink mesh agent (private network between your servers)
Documentation=https://github.com/winyannainghtut/GHOSTLINK/blob/main/docs/deployment/mesh.md
After=network-online.target
Wants=network-online.target
# After Docker where it is installed (no dependency): its DOCKER-USER chain then exists when the
# agent first puts its firewall jumps in, so Docker's rules never run ahead of the mesh's.
After=docker.service
# Started only after this machine joined a mesh (ghostlink-mesh join).
ConditionPathExists=/var/lib/ghostlink-mesh/node.json

[Service]
Type=simple
ExecStart=/usr/bin/ghostlink-mesh serve
Restart=on-failure
RestartSec=5
UMask=0077
StateDirectory=ghostlink-mesh
StateDirectoryMode=0700
# Kernel WireGuard, routes and the agent's own firewall chains need only these.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
# State, the managed /etc/hosts block, and iptables' lock under /run.
ReadWritePaths=/var/lib/ghostlink-mesh /etc/hosts /run
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
