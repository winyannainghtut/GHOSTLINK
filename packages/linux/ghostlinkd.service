[Unit]
Description=Ghostlink privileged local tunnel service
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
EnvironmentFile=/etc/ghostlink/ghostlinkd.env
ExecStart=/usr/local/bin/ghostlinkd --owner-uid ${GHOSTLINK_OWNER_UID} --outline-engine /usr/local/lib/ghostlink/ghostlink-tunnel $GHOSTLINK_FLAGS
Restart=on-failure
RestartSec=3
TimeoutStopSec=25
RuntimeDirectory=ghostlink
RuntimeDirectoryMode=0755
StateDirectory=ghostlink
StateDirectoryMode=0700
UMask=0077
# CAP_CHOWN: the daemon hands the control socket to GHOSTLINK_OWNER_UID at startup.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_CHOWN
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/run/ghostlink /var/lib/ghostlink
[Install]
WantedBy=multi-user.target
