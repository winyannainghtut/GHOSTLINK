# Only this dedicated table is replaced. Never flush the host ruleset.
add table ip myvpn_nat
flush table ip myvpn_nat
add chain ip myvpn_nat postrouting { type nat hook postrouting priority srcnat; policy accept; }
add rule ip myvpn_nat postrouting ip saddr 10.8.0.0/24 oifname "{{ myvpn_public_interface }}" masquerade
