[Unit]
Description=MyVPN dedicated IPv4 NAT rules
Before=openvpn-server@myvpn.service
After=network-pre.target
[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/openvpn/myvpn.nft
ExecReload=/usr/sbin/nft -f /etc/openvpn/myvpn.nft
ExecStop=-/usr/sbin/nft delete table ip myvpn_nat
[Install]
WantedBy=multi-user.target
