{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghostlink",
  "version": "0.6.0",
  "identifier": "app.ghostlink.client",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Ghostlink", "width": 1060, "height": 760, "minWidth": 620, "minHeight": 560 }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'" }
  },
  "bundle": { "active": true, "targets": ["msi", "deb", "rpm"], "icon": ["icons/icon.png", "icons/icon.ico"], "shortDescription": "Personal Outline-compatible VPN client" }
}
